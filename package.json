    "lint-staged": "^15.2.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.64.0",
    "nodemailer": "^6.9.7",
    "nodemon": "^3.0.2",
    "pg": "^8.11.3",
    "prettier": "^3.1.0",
    "rate-limiter-flexible": "^4.0.1",
    "redis": "^4.6.10",
    "sharp": "^0.32.6",
    "socket.io": "^4.7.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tonweb": "^0.0.66",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3",
    "web3": "^4.3.0",
    "winston": "^3.11.0",
