# =============================================================================
# PANACEA TON WALLET - VERCEL ENVIRONMENT VARIABLES
# =============================================================================
# Copia este archivo como .env.vercel y configura tus variables
# =============================================================================

# Vercel Configuration
VERCEL_TOKEN=your_vercel_token_here
VERCEL_ORG_ID=your_vercel_org_id_here
VERCEL_PROJECT_ID=your_vercel_project_id_here

# Application Environment
NODE_ENV=production
VERCEL=1
REACT_APP_API_URL=https://panacea-ton-wallet.vercel.app/api
REACT_APP_ENVIRONMENT=production

# TON Network Configuration
REACT_APP_TON_NETWORK=mainnet
REACT_APP_TON_API_URL=https://toncenter.com/api/v2
REACT_APP_TON_API_KEY=your_ton_api_key_here

# Solana Network Configuration
REACT_APP_SOLANA_NETWORK=mainnet-beta
REACT_APP_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Algorand Network Configuration
REACT_APP_ALGORAND_NETWORK=mainnet
REACT_APP_ALGORAND_API_URL=https://mainnet-api.algonode.cloud

# Security and Features
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_SENTRY=false
REACT_APP_SENTRY_DSN=your_sentry_dsn_here

# Bot Integration (opcional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://panacea-ton-wallet.vercel.app/api/webhook

# Database (si se usa)
DATABASE_URL=your_database_url_here

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# CORS Origins
CORS_ORIGINS=https://panacea-ton-wallet.vercel.app,https://t.me