# =============================================================================
# PANACEA ICONO SA - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Configuración completa para producción con todas las APIs de Heroku
# =============================================================================

# =============================================================================
# ORGANIZACIÓN Y CONTACTO
# =============================================================================
ORG_NAME=panacea-icono
ORG_DISPLAY_NAME="Dr. Ignacio Tapia Vargas - Panacea Icono SA"
ORG_EMAIL=repositorios.panacea@gmail.com
ORG_WEBSITE=https://panacea-icono.org/
ORG_DESCRIPTION="Cirujano plástico | Full Stack Developer | Fundador de Panacea Icono S.A."

# =============================================================================
# HEROKU APPS - CUENTA PERSONAL
# =============================================================================
# Fibonacci API
FIBONACCI_HEROKU_URL=https://fibonacci-b33f2f33a8ad.herokuapp.com
FIBONACCI_HEROKU_APP=fibonacci-b33f2f33a8ad

# Kuchiuyas Algorand
KUCHIUYAS_ALGORAND_URL=https://kuchiuyas-algorand-d0bd2e62d823.herokuapp.com
KUCHIUYAS_ALGORAND_APP=kuchiuyas-algorand-d0bd2e62d823

# Backend Developer
BACKEND_DEVELOPER_URL=https://backend-developer-d160b40c29bc.herokuapp.com
BACKEND_DEVELOPER_APP=backend-developer-d160b40c29bc

# API Panacea
API_PANACEA_URL=https://api-panacea-638dc550fab6.herokuapp.com
API_PANACEA_APP=api-panacea-638dc550fab6

# Dashboard Heroku
HEROKU_DASHBOARD_URL=https://dashboard.heroku.com/apps/panacea-icono

# =============================================================================
# HEROKU APPS - CUENTA EMPRESA
# =============================================================================
# TON Telegram Orquestador
TON_TELEGRAM_ORQUESTADOR_URL=https://ton-telegram-orquestador-185e533131f8.herokuapp.com
TON_TELEGRAM_ORQUESTADOR_APP=ton-telegram-orquestador-185e533131f8

# Fibonacci (Empresa)
FIBONACCI_EMPRESA_URL=https://fibonacci-b33f2f33a8ad.herokuapp.com
FIBONACCI_EMPRESA_APP=fibonacci-b33f2f33a8ad

# Kuchiuyas (Empresa)
KUCHIUYAS_EMPRESA_URL=https://kuchiuyas-72a39bde11fc.herokuapp.com
KUCHIUYAS_EMPRESA_APP=kuchiuyas-72a39bde11fc

# =============================================================================
# TELEGRAM CONFIGURATION
# =============================================================================
# Autorización Telegram
TELEGRAM_AUTH_TOKEN=your_telegram_auth_token_here

# API Key Telegram
TELEGRAM_API_KEY=your_telegram_api_key_here

# Bot Token (si es diferente)
TELEGRAM_BOT_TOKEN=${TELEGRAM_AUTH_TOKEN}

# Webhook URL
TELEGRAM_WEBHOOK_URL=${TON_TELEGRAM_ORQUESTADOR_URL}/webhook

# =============================================================================
# SSH KEYS
# =============================================================================
# SSH Key 1
SSH_KEY_1=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOK8SHT0XvZ7YwJb68UQU9amU3l57aNzBPWDVzRraUvR repositorios.panacea@gmail.com

# SSH Key 2
SSH_KEY_2=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIM6RuBi2QkcWcaylOz1YXK7LKkEmnnCW+MONBMmgh9Ee repositorios.panacea@gmail.com

# =============================================================================
# BLOCKCHAIN CONFIGURATION
# =============================================================================
# TON Network
TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=${TELEGRAM_API_KEY}
TON_NETWORK=mainnet

# Solana Network
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta

# Algorand Network
ALGORAND_RPC_URL=https://mainnet-api.algonode.cloud
ALGORAND_NETWORK=mainnet

# BSC Network
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_NETWORK=mainnet

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL (Heroku)
DATABASE_URL=${API_PANACEA_URL}/database
POSTGRES_URL=${DATABASE_URL}

# Redis (Heroku)
REDIS_URL=${API_PANACEA_URL}/redis

# MongoDB (si se usa)
MONGODB_URL=${API_PANACEA_URL}/mongodb

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Secret
JWT_SECRET=panacea_icono_jwt_secret_2024_secure_key

# Encryption Key
ENCRYPTION_KEY=panacea_icono_encryption_key_2024_secure

# API Keys
API_SECRET_KEY=panacea_icono_api_secret_2024

# =============================================================================
# HUGGING FACE CONFIGURATION
# =============================================================================
# Hugging Face API
HUGGINGFACE_API_URL=https://api-inference.huggingface.co
HUGGINGFACE_API_KEY=${TELEGRAM_API_KEY}

# Modelos específicos
HUGGINGFACE_MODEL_MEDICAL=panacea-icono/medical-ai-model
HUGGINGFACE_MODEL_SURGERY=panacea-icono/surgery-simulator

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Docker Registry
DOCKER_REGISTRY=registry.heroku.com
DOCKER_IMAGE_PREFIX=panacea-icono

# Container URLs
DOCKER_FIBONACCI_URL=${FIBONACCI_HEROKU_URL}
DOCKER_KUCHIUYAS_URL=${KUCHIUYAS_ALGORAND_URL}
DOCKER_BACKEND_URL=${BACKEND_DEVELOPER_URL}
DOCKER_API_URL=${API_PANACEA_URL}

# =============================================================================
# CI/CD PIPELINE CONFIGURATION
# =============================================================================
# GitHub Actions
GITHUB_TOKEN=${TELEGRAM_AUTH_TOKEN}
GITHUB_ORG=panacea-icono

# Heroku CLI
HEROKU_API_KEY=${TELEGRAM_API_KEY}
HEROKU_APP_NAME=panacea-icono

# Deployment
DEPLOY_ENVIRONMENT=production
DEPLOY_BRANCH=main

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
# Log Level
LOG_LEVEL=info

# Monitoring URLs
MONITORING_URL=${HEROKU_DASHBOARD_URL}
HEALTH_CHECK_URL=${API_PANACEA_URL}/health

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Email Service
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=${TELEGRAM_API_KEY}

# SMS Service
SMS_SERVICE=twilio
SMS_API_KEY=${TELEGRAM_API_KEY}

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Node Environment
NODE_ENV=production

# Debug Mode
DEBUG=false

# Port Configuration
PORT=3000
API_PORT=3001
BOT_PORT=3002

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable Features
ENABLE_TELEGRAM_BOT=true
ENABLE_BLOCKCHAIN_INTEGRATION=true
ENABLE_AI_FEATURES=true
ENABLE_PAYMENT_PROCESSING=true
ENABLE_MEDICAL_SIMULATOR=true

# =============================================================================
# RATE LIMITING
# =============================================================================
# API Rate Limits
API_RATE_LIMIT=1000
API_RATE_WINDOW=3600000

# Bot Rate Limits
BOT_RATE_LIMIT=100
BOT_RATE_WINDOW=60000

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Redis Cache
CACHE_TTL=3600
CACHE_PREFIX=panacea_icono

# =============================================================================
# FILE STORAGE
# =============================================================================
# AWS S3 (si se usa)
AWS_ACCESS_KEY_ID=${TELEGRAM_API_KEY}
AWS_SECRET_ACCESS_KEY=${TELEGRAM_AUTH_TOKEN}
AWS_BUCKET_NAME=panacea-icono-storage

# =============================================================================
# ANALYTICS
# =============================================================================
# Google Analytics
GA_TRACKING_ID=GA-XXXXXXXXX

# Custom Analytics
ANALYTICS_ENDPOINT=${API_PANACEA_URL}/analytics

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup URLs
BACKUP_DATABASE_URL=${DATABASE_URL}/backup
BACKUP_FILES_URL=${API_PANACEA_URL}/backup

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================
# Slack (si se usa)
SLACK_WEBHOOK_URL=${API_PANACEA_URL}/slack

# Discord (si se usa)
DISCORD_WEBHOOK_URL=${API_PANACEA_URL}/discord

# =============================================================================
# VERSION INFORMATION
# =============================================================================
APP_VERSION=1.0.0
API_VERSION=v1
BUILD_DATE=2024-09-07T00:00:00Z
COMMIT_HASH=local

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
