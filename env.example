# 🌐 Panas Token - Configuración del Ecosistema
# Panacea | Icono SA
# Versión: 1.0.0

# =============================================================================
# CONFIGURACIÓN GENERAL
# =============================================================================
NODE_ENV=development
DEBUG=true
LOG_LEVEL=debug
PORT=3000
API_VERSION=v1

# =============================================================================
# BASE DE DATOS
# =============================================================================
DATABASE_URL=postgresql://panas:panas_password@localhost:5432/panas_token
REDIS_URL=redis://localhost:6379
MONGODB_URL=mongodb://localhost:27017/panas_token

# =============================================================================
# TELEGRAM BOT
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram
TELEGRAM_BOT_USERNAME=panas_token_bot

# =============================================================================
# TON BLOCKCHAIN
# =============================================================================
TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=your_ton_api_key_here
TON_TESTNET_RPC_URL=https://testnet.toncenter.com/api/v2/jsonRPC
TON_MAINNET_RPC_URL=https://toncenter.com/api/v2/jsonRPC

# TON Wallet
TON_WALLET_MNEMONIC=your_ton_wallet_mnemonic_here
TON_WALLET_ADDRESS=your_ton_wallet_address_here

# TON Jetton (Panas Token)
TON_JETTON_MASTER_ADDRESS=your_jetton_master_address_here
TON_JETTON_WALLET_ADDRESS=your_jetton_wallet_address_here

# =============================================================================
# SOLANA BLOCKCHAIN
# =============================================================================
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_TESTNET_RPC_URL=https://api.testnet.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Solana Wallet
SOLANA_PRIVATE_KEY=your_solana_private_key_here
SOLANA_WALLET_ADDRESS=your_solana_wallet_address_here

# SPL Tokens
SOLANA_PANAS_TOKEN_ADDRESS=your_solana_panas_token_address_here
SOLANA_GS_TOKEN_ADDRESS=your_solana_gs_token_address_here
SOLANA_VASER_TOKEN_ADDRESS=your_solana_vaser_token_address_here

# =============================================================================
# ALGORAND BLOCKCHAIN
# =============================================================================
ALGORAND_RPC_URL=https://mainnet-api.algonode.cloud
ALGORAND_TESTNET_RPC_URL=https://testnet-api.algonode.cloud
ALGORAND_API_KEY=your_algorand_api_key_here

# Algorand Wallet
ALGORAND_PRIVATE_KEY=your_algorand_private_key_here
ALGORAND_WALLET_ADDRESS=your_algorand_wallet_address_here

# ASA Tokens
ALGORAND_PANAS_ASA_ID=your_panas_asa_id_here
ALGORAND_GS_ASA_ID=your_gs_asa_id_here

# NF Domains
ALGORAND_NF_DOMAINS_CONTRACT=your_nf_domains_contract_here
ALGORAND_PANAS_DOMAIN=panas.algo
ALGORAND_TREASURY_DOMAIN=treasury.algo

# =============================================================================
# BSC (BINANCE SMART CHAIN)
# =============================================================================
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_API_KEY=your_bsc_api_key_here

# BSC Wallet
BSC_PRIVATE_KEY=your_bsc_private_key_here
BSC_WALLET_ADDRESS=your_bsc_wallet_address_here

# BEP-20 Tokens
BSC_PANAS_TOKEN_ADDRESS=your_bsc_panas_token_address_here
BSC_KUCHI_TOKEN_ADDRESS=your_bsc_kuchi_token_address_here

# =============================================================================
# DEX INTEGRATIONS
# =============================================================================
# Raydium (Solana)
RAYDIUM_API_URL=https://api.raydium.io/v2
RAYDIUM_POOL_ID_PANAS_USDC=your_raydium_pool_id_here

# Meteora (Solana)
METEORA_API_URL=https://app.meteora.ag/amm
METEORA_POOL_ID_PANAS_VASER=your_meteora_pool_id_here

# PancakeSwap (BSC)
PANCAKESWAP_API_URL=https://api.pancakeswap.info/api/v1
PANCAKESWAP_ROUTER_ADDRESS=0x10ED43C718714eb63d5aA57B78B54704E256024E

# Tinyman (Algorand)
TINYMAN_API_URL=https://mainnet.analytics.tinyman.org/api/v1
TINYMAN_APP_ID=1002541853

# DeDust (TON)
DEDUST_API_URL=https://api.dedust.io/v2
DEDUST_POOL_ID_PANAS_USDC=your_dedust_pool_id_here

# =============================================================================
# EXTERNAL APIs
# =============================================================================
# CoinGecko
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=your_coingecko_api_key_here

# CoinMarketCap
COINMARKETCAP_API_URL=https://pro-api.coinmarketcap.com/v1
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=your_encryption_key_here

# API Keys
API_KEY_PREFIX=panas
API_RATE_LIMIT=1000
API_RATE_WINDOW=900000

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
SENTRY_DSN=your_sentry_dsn_here
LOGTAIL_SOURCE_TOKEN=your_logtail_token_here

# Health Check
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password_here

# Push Notifications
FCM_SERVER_KEY=your_fcm_server_key_here
FCM_SENDER_ID=your_fcm_sender_id_here

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
REACT_APP_API_URL=http://localhost:3000
REACT_APP_TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC
REACT_APP_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
REACT_APP_ALGORAND_RPC_URL=https://mainnet-api.algonode.cloud
REACT_APP_BSC_RPC_URL=https://bsc-dataseed.binance.org

# =============================================================================
# DEVELOPMENT
# =============================================================================
# Hot Reload
HOT_RELOAD=true
WATCH_MODE=true

# Testing
TEST_DATABASE_URL=postgresql://panas:panas_password@localhost:5432/panas_token_test
TEST_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Descomenta y configura para producción
# NODE_ENV=production
# DEBUG=false
# LOG_LEVEL=info
# DATABASE_URL=postgresql://user:password@prod-db:5432/panas_token
# REDIS_URL=redis://prod-redis:6379
