# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================

# Development mode settings
if [ "$NODE_ENV" = "development" ]; then
    export SKIP_CONFIRMATIONS="true"
    export DETAILED_STATUS="true" 
    export LOG_LEVEL="debug"
fi

# Local development settings
if [ "$DEPLOY_ENV" = "local" ]; then
    export TON_NETWORK="testnet"
    export SOLANA_NETWORK="devnet"
    export ALGORAND_NETWORK="testnet"
    export BSC_NETWORK="testnet"
fi

# =============================================================================
# HELPER FUNCTIONS
# =============================================================================

# Function to validate required environment variables
validate_env() {
    local required_vars=(
        "DEPLOY_ENV"
        "TON_NETWORK"
        "SOLANA_NETWORK"
        "ALGORAND_NETWORK"
        "BSC_NETWORK"
    )
    
    for var in "${required_vars[@]}"; do
        if [ -z "${!var}" ]; then
            echo "❌ Required environment variable $var is not set"
            return 1
        fi
    done
    
    echo "✅ All required environment variables are set"
    return 0
}

# Function to display current configuration
show_config() {
    echo "🌐 Panas Token Ecosystem Configuration"
    echo "====================================="
    echo "Environment: $DEPLOY_ENV"
    echo "TON Network: $TON_NETWORK"
    echo "Solana Network: $SOLANA_NETWORK"  
    echo "Algorand Network: $ALGORAND_NETWORK"
    echo "BSC Network: $BSC_NETWORK"
    echo "====================================="
}

# =============================================================================
# USAGE
# =============================================================================

# To use this configuration file:
# 1. Copy to .env or source directly: source config/ecosystem.env
# 2. Customize the values for your environment
# 3. Validate configuration: validate_env
# 4. Show current config: show_config

# For production environments, ensure sensitive values like private keys
# and API keys are stored securely (e.g., in a secrets manager)