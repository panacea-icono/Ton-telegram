# =============================================================================
# PANAS TOKEN ECOSYSTEM — CONFIGURATION SCHEMA (FILL ME)
# =============================================================================
# Copy or merge into your local `.env` or `.env.local` and fill values.
# Do not commit real secrets.
# =============================================================================

# =============================
# GENERAL
# =============================
NODE_ENV=development
APP_NAME=Panas Token Ecosystem
APP_VERSION=1.0.0
APP_DESCRIPTION=
COMPANY=Panacea Icono SA
SUPPORT_EMAIL=info@iconosa.com
WEBSITE=https://iconosa.com
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
API_VERSION=1.0.0

# =============================
# GITHUB INTEGRATION
# =============================
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_USERNAME=
GITHUB_REPOS_SCOPE=
GITHUB_REQUIRED_SCOPES=
# Optional GitHub App
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=

# =============================
# TELEGRAM — BOT API (MULTI-BOT)
# =============================
# Option A: single bot (legacy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Option B: multi-bot orchestrator
BOTS_LIST=
# For each name in BOTS_LIST, export BOT_<NAME>_TOKEN in shell
# Example: BOTS_LIST="main,payments" + BOT_MAIN_TOKEN=... BOT_PAYMENTS_TOKEN=...

# Publisher module / channel posting
TELEGRAM_OFFICIAL_CHANNEL=@drtapiavargas_of
TELEGRAM_BOT_ADMINS=

# =============================
# TELEGRAM — OPTIONAL APIS
# =============================
# TDLib (custom client)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Gateway API (replace SMS codes)
TELEGRAM_GATEWAY_API_TOKEN=

# Mini App flags
TELEGRAM_MINIAPP_TON_ONLY=true

# =============================
# AI / LLM PROVIDERS
# =============================
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Llama / Otros (si usas endpoints propios)
LLAMA_API_URL=
LLAMA_API_KEY=

# Custom FastAPI / Heroku (tu super api)
CUSTOM_AI_API_URL=
CUSTOM_AI_API_KEY=

# =============================
# TON (The Open Network)
# =============================
TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=
TON_NETWORK=mainnet
TON_WALLET_VERSION=v4r2

# =============================
# SOLANA
# =============================
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
SOLANA_COMMITMENT=confirmed

# =============================
# ALGORAND
# =============================
ALGORAND_RPC_URL=https://mainnet-api.algonode.cloud
ALGORAND_NETWORK=mainnet
ALGORAND_TOKEN=

# =============================
# BINANCE SMART CHAIN (BSC)
# =============================
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_NETWORK=mainnet
BSC_CHAIN_ID=56

# =============================
# DATABASES & CACHE
# =============================
DATABASE_URL=postgresql://panas:panas_password@localhost:5432/panas_token
REDIS_URL=redis://localhost:6379

# =============================
# SECURITY
# =============================
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=
ENCRYPTION_ALGORITHM=AES-256-GCM
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================
# MONITORING & LOGGING
# =============================
SENTRY_DSN=
LOGTAIL_SOURCE_TOKEN=
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE=./logs/panas-token.log
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================
# DEX / INTEGRATIONS (optional)
# =============================
RAYDIUM_API_URL=https://api.raydium.io/v2
RAYDIUM_POOL_ID=
METEORA_API_URL=https://app.meteora.ag/amm/pools
METEORA_POOL_ID=
PANCAKESWAP_API_URL=https://api.pancakeswap.info/api/v2
PANCAKESWAP_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
TINYMAN_API_URL=https://mainnet.analytics.tinyman.org/api/v1
TINYMAN_APP_ID=1002541853
DEDUST_API_URL=https://api.dedust.io/v2
DEDUST_POOL_ID=
STONFI_API_URL=https://api.ston.fi
STONFI_POOL_ID=

# =============================
# TOKEN ADDRESSES
# =============================
PANAS_TOKEN_ADDRESS_TON=
PANAS_TOKEN_ADDRESS_SOLANA=
PANAS_TOKEN_ADDRESS_ALGORAND=
PANAS_TOKEN_ADDRESS_BSC=
GS_TOKEN_ADDRESS_SOLANA=
VASER_TOKEN_ADDRESS_SOLANA=
KUCHI_TOKEN_ADDRESS_BSC=

# =============================
# NF DOMAINS (ALGORAND)
# =============================
NF_DOMAINS_ENABLED=true
NF_DOMAINS_API_URL=https://api.nf.domains
NF_DOMAINS_CONTRACT_ID=

# =============================
# NOTIFICATIONS
# =============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FCM_SERVER_KEY=
FCM_SENDER_ID=

# =============================
# BACKUP / AUDIT
# =============================
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups
AUDIT_ENABLED=true
AUDIT_LOG_LEVEL=info
AUDIT_RETENTION_DAYS=90
AUDIT_STORAGE_PATH=./audit-logs

# =============================
# DOCKER / CI
# =============================
DOCKER_COMPOSE_FILE=docker-compose.yml
DOCKER_NETWORK=panas-token-network
CI_ENABLED=true
CD_ENABLED=false
DEPLOYMENT_ENVIRONMENT=development

# =============================
# EXTERNAL (wallet secure config)
# =============================
ACCESS_TOKEN_URL=https://token.drtapiavargas.com/

# =============================
# SOCIAL NETWORKS & MESSAGING
# =============================
# X / Twitter
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Facebook / Instagram (Graph API)
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=
IG_APP_ID=
IG_APP_SECRET=
IG_USER_ID=

# YouTube
YOUTUBE_API_KEY=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# WhatsApp Business (via Facebook)
