# =============================
# LOCAL ENV (MACBOOK) — PRIVATE
# =============================
# Copia este archivo a `.env.local` y completa SOLO en tu máquina.
# Nunca lo subas a Git. `.env.local` ya está ignorado.

################################
# Telegram (Orquestador + Canal)
################################
TELEGRAM_OFFICIAL_CHANNEL=@drtapiavargas_of
# IDs numéricos con permiso para publicar (/post, /post_html, /schedule)
TELEGRAM_BOT_ADMINS=

# Tokens de bots (puedes mantenerlos en .env.telegram.local si prefieres separarlos)
# Ejemplos de variables (ver config/telegram-bots.schema.env para la lista completa)
# BOT_DR_TAPIA_BOT_TOKEN=
# BOT_PANAS_TOKEN_BOT_TOKEN=
# BOT_ANASTASIA_PANACEA_BOT_TOKEN=

##############
# OpenAI (IA)
##############
# Clave global (fallback para /ask en bots sin `ai.apiKeyEnv`)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claves por proyecto (asigna a bots en config/bots.config.json → ai.apiKeyEnv)
OPENAI_API_KEY_KUCHIUYAS=
OPENAI_API_KEY_FIBONACCI=
OPENAI_API_KEY_CODIGO=
OPENAI_API_KEY_HF=
OPENAI_API_KEY_CIRUGIAPLASTICA=

###########################
# Llama / Custom API (opt)
###########################
LLAMA_API_URL=
LLAMA_API_KEY=

CUSTOM_AI_API_URL=
CUSTOM_AI_API_KEY=

