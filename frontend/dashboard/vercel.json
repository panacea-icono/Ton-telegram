{
  "version": 2,
  "name": "panacea-ton-wallet",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "REACT_APP_API_URL": "https://www.panas.app/api",
    "REACT_APP_TON_RPC": "https://toncenter.com/api/v2/jsonRPC",
    "REACT_APP_SOLANA_RPC": "https://api.mainnet-beta.solana.com",
    "REACT_APP_ALGORAND_RPC": "https://mainnet-api.algonode.cloud",
    "REACT_APP_WEBSITE_URL": "https://www.panas.app",
    "REACT_APP_TELEGRAM_BOT_URL": "https://t.me/panacea_icono_bot"
  },
  "regions": ["iad1"],
  "framework": "create-react-app"
}
