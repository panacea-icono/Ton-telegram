# Local overrides only. Do NOT commit real secrets.

# Example local-only variables
NODE_ENV=development
LOG_LEVEL=debug

# Ports
PORT=3000
HOT_RELOAD=true

# Telegram (set your local bot token here)
TELEGRAM_BOT_TOKEN=

# GitHub (for repo listing; keep empty if not needed)
GITHUB_TOKEN=
