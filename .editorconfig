# =============================================================================
# PANAS TOKEN ECOSYSTEM - EDITOR CONFIG
# Panacea | Icono SA
# =============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.{js,ts,jsx,tsx}]
indent_size = 2

[*.{html,css,scss}]
indent_size = 2

[*.{py,rb}]
indent_size = 4

[*.{go,rs}]
indent_size = 4

[*.{sql,sh}]
indent_size = 2
